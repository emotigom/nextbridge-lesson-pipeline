{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextbridge.example/contracts/pipeline-state.schema.json",
  "title": "Nextbridge Lesson Pipeline State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","courseId","activeWip","sessionCount","factory","approvals"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "courseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "activeWip": {"type": "boolean"},
    "sessionCount": {"type": "integer", "minimum": 1, "maximum": 20},
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository","commitSha","verificationMode","designRefPath"],
      "properties": {
        "repository": {"const": "emotigom/nextbridge-lesson-factory"},
        "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "verificationMode": {"enum": ["HANDOFF_LINEAGE","PUBLIC_BUNDLE","PRIVATE_PROOF"]},
        "designRefPath": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designVersion","qualityOverall","packageSha256","presentationSha256","practiceToolSha256","activityPackSha256"],
      "properties": {
        "designVersion": {"type": "string", "minLength": 1},
        "qualityOverall": {"type": "number", "minimum": 0, "maximum": 100},
        "packageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "presentationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "practiceToolSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "activityPackSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanIntake","courseMap","sessions","allContent","pptxBuild","practiceToolBuild"],
      "properties": {
        "cleanIntake": {"$ref": "#/$defs/approval"},
        "courseMap": {"$ref": "#/$defs/approval"},
        "sessions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["session","status","reviewer","approvedAt"],
            "properties": {
              "session": {"type": "integer", "minimum": 1},
              "status": {"enum": ["PENDING","APPROVED"]},
              "reviewer": {"type": ["string","null"]},
              "approvedAt": {"type": ["string","null"]}
            }
          }
        },
        "allContent": {"$ref": "#/$defs/approval"},
        "pptxBuild": {"$ref": "#/$defs/approval"},
        "practiceToolBuild": {"$ref": "#/$defs/approval"}
      }
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status","reviewer","approvedAt"],
      "properties": {
        "status": {"enum": ["PENDING","APPROVED"]},
        "reviewer": {"type": ["string","null"]},
        "approvedAt": {"type": ["string","null"]}
      }
    }
  }
}
